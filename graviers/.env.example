APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ======================================================================
# FNE - Facture Normalisée Electronique (DGI - Côte d'Ivoire)
# ----------------------------------------------------------------------
# Tant que la DGI n'a pas encore validé l'intégration et fourni la clé
# API, laissez FNE_ENABLED=false : la facture sera créée localement
# sans appel HTTP à la plateforme FNE.
#
# Étapes :
#  1. Inscrire l'entreprise sur http://54.247.95.108
#  2. Effectuer les tests sur l'environnement test (FNE_BASE_URL ci-dessous)
#  3. Envoyer les spécimens de factures à support.fne@dgi.gouv.ci
#  4. Une fois validé : la DGI fournit l'URL de prod et la clé API,
#     remplir FNE_API_KEY puis passer FNE_ENABLED=true.
# ======================================================================
FNE_ENABLED=false
FNE_BASE_URL=http://54.247.95.108/ws
FNE_API_KEY=
FNE_TIMEOUT=20
FNE_RETRY_TIMES=1
FNE_RETRY_SLEEP=500

# Valeurs par défaut envoyées à la plateforme FNE
FNE_DEFAULT_TEMPLATE=B2C
FNE_DEFAULT_PAYMENT_METHOD=cash
FNE_DEFAULT_TAX=TVA
FNE_POINT_OF_SALE=PDV-01
FNE_ESTABLISHMENT=GRAVIERS
FNE_COMMERCIAL_MESSAGE=
FNE_FOOTER=

# Si true, la facture est rejetée quand la plateforme FNE est indisponible.
# Recommandé : false en attendant les credentials.
FNE_BLOCK_ON_FAILURE=false
FNE_LOG_CHANNEL=stack
